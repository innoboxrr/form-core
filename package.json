{
  "name": "innoboxrr-form-core",
  "version": "2.2.0",
  "description": "El nucleo agnostico de los formularios innoboxrr: tema, archivos y zonas horarias.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./theme": "./src/theme.js",
    "./icons": "./src/icons.js",
    "./files": "./src/files.js",
    "./timezone": "./src/timezone.js",
    "./styles": "./styles.css",
    "./styles.css": "./styles.css",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./layout.css": "./src/layout.css",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "styles.css",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innoboxrr/form-core.git"
  },
  "keywords": [
    "form",
    "theme",
    "innoboxrr"
  ],
  "author": "Homero Raul Vargas Cruz",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "vitest": "^3.0.0"
  }
}
